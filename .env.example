DATABASE_URL=postgres://user:password@localhost:5432/tasks

# LLM (OpenRouter, OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your_openrouter_key
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# LLM_STUB=1 skips the model call entirely and returns a hardcoded valid response
LLM_STUB=0
# LLM_ENABLED=false is a kill switch: returns a safe fallback with zero model calls
LLM_ENABLED=true

# Inngest local dev mode (no signing key needed)
INNGEST_DEV=1
